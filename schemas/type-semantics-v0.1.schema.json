{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anidiagram.dev/schemas/type-semantics-v0.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "details",
    "groups"
  ],
  "properties": {
    "kind": {
      "enum": [
        "sequence",
        "lifecycle",
        "dataflow",
        "workflow",
        "architecture"
      ]
    },
    "details": {
      "$ref": "#/$defs/details"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "members"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "sequence"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "$ref": "#/$defs/sequence"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "lifecycle"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "$ref": "#/$defs/lifecycle"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "dataflow"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "$ref": "#/$defs/dataflow"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "workflow"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "$ref": "#/$defs/workflow"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "architecture"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "$ref": "#/$defs/architecture"
          }
        }
      }
    }
  ],
  "$defs": {
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participants",
        "messages"
      ],
      "properties": {
        "participants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relation_id",
              "mode"
            ],
            "properties": {
              "relation_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "mode": {
                "enum": [
                  "sync",
                  "async",
                  "return"
                ]
              },
              "reply_to": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              }
            }
          }
        },
        "activations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "participant",
              "start",
              "end"
            ],
            "properties": {
              "participant": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "start": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "end": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              }
            }
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial",
        "terminal"
      ],
      "properties": {
        "initial": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "terminal": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "recovery_relations": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        }
      }
    },
    "dataflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasets",
        "transformations"
      ],
      "properties": {
        "datasets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "transformations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entity_id",
              "inputs",
              "outputs"
            ],
            "properties": {
              "entity_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "inputs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                }
              },
              "outputs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                }
              }
            }
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvals"
      ],
      "properties": {
        "approvals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entity_id",
              "approved",
              "rejected"
            ],
            "properties": {
              "entity_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "approved": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "rejected": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              }
            }
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "ownership": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "group_id",
              "owner"
            ],
            "properties": {
              "group_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "owner": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "trust_boundaries": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "crossings": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relation_id",
              "mechanism"
            ],
            "properties": {
              "relation_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "mechanism": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "minProperties": 1
    },
    "details": {
      "oneOf": [
        {
          "$ref": "#/$defs/sequence"
        },
        {
          "$ref": "#/$defs/lifecycle"
        },
        {
          "$ref": "#/$defs/dataflow"
        },
        {
          "$ref": "#/$defs/workflow"
        },
        {
          "$ref": "#/$defs/architecture"
        }
      ]
    }
  }
}
