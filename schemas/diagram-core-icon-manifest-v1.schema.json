{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anidiagram.dev/schemas/diagram-core-icon-manifest-v1.schema.json",
  "title": "AniDiagram Diagram Core Icon Asset Manifest v1",
  "type": "object",
  "required": [
    "id",
    "system",
    "asset_revision",
    "viewBox",
    "category",
    "semantic_kind",
    "structural_prototype",
    "parts",
    "attachments",
    "states",
    "actions",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {"$ref": "#/$defs/identifier"},
    "system": {"const": "diagram-core-v1"},
    "asset_revision": {"type": "integer", "minimum": 1},
    "viewBox": {"const": "0 0 96 96"},
    "category": {"$ref": "#/$defs/identifier"},
    "semantic_kind": {"$ref": "#/$defs/identifier"},
    "structural_prototype": {"$ref": "#/$defs/identifier"},
    "parts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "attachments": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/attachment"}
    },
    "states": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "status": {
      "enum": ["visual-review", "approved", "deprecated"]
    },
    "exceptions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/exception"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "attachment": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 96},
        "y": {"type": "number", "minimum": 0, "maximum": 96}
      }
    },
    "exception": {
      "type": "object",
      "required": ["metric", "reason", "reviewer", "approved_on"],
      "additionalProperties": false,
      "properties": {
        "metric": {
          "enum": [
            "raw-size",
            "gzip-size",
            "paintable-elements",
            "non-scaling-stroke"
          ]
        },
        "reason": {"type": "string", "minLength": 1},
        "reviewer": {"type": "string", "minLength": 1},
        "approved_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    }
  }
}
