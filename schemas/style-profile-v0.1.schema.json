{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anidiagram.dev/schemas/style-profile-v0.1.schema.json",
  "title": "AniDiagram Style Profile v0.1",
  "type": "object",
  "required": ["name"],
  "properties": {
    "name": {"type": "string"},
    "canvas": {
      "type": "object",
      "properties": {
        "background": {"type": "string"},
        "text": {"type": "string"},
        "muted": {"type": "string"},
        "grid": {"type": "string"}
      }
    },
    "title": {
      "type": "object",
      "properties": {
        "accent": {"type": "string"},
        "highlight": {"type": "string"}
      }
    },
    "node": {
      "type": "object",
      "properties": {
        "radius": {"type": "number", "minimum": 0},
        "stroke_width": {"type": "number", "exclusiveMinimum": 0},
        "fill_mode": {"type": "string", "enum": ["solid", "aurora"]}
      }
    },
    "edge": {
      "type": "object",
      "properties": {
        "width": {"type": "number", "exclusiveMinimum": 0},
        "duration": {"type": "string"}
      }
    },
    "effects": {
      "type": "object",
      "properties": {
        "node_fill": {"type": "string", "enum": ["solid", "aurora"]},
        "grain_opacity": {"type": "number", "minimum": 0, "maximum": 1},
        "blob_opacity": {"type": "number", "minimum": 0, "maximum": 1},
        "band_opacity": {"type": "number", "minimum": 0, "maximum": 1},
        "node_border_opacity": {"type": "number", "minimum": 0, "maximum": 1},
        "grid_opacity": {"type": "number", "minimum": 0, "maximum": 1},
        "frame_opacity": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "stroke": {"type": "string"},
          "fill": {"type": "string"},
          "text": {"type": "string"},
          "glow": {"type": "string"},
          "band": {"type": "string"},
          "shadow": {"type": "string"},
          "gradient": {
            "type": "array",
            "items": {
              "oneOf": [
                {"type": "string"},
                {
                  "type": "object",
                  "required": ["color"],
                  "properties": {
                    "offset": {"type": "string"},
                    "color": {"type": "string"},
                    "opacity": {"type": "number", "minimum": 0, "maximum": 1}
                  }
                }
              ]
            },
            "minItems": 2
          }
        }
      }
    }
  }
}
