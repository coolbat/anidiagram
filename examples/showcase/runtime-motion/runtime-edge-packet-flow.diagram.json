{
  "version": "0.3",
  "preset": "runtime-edge-packet-flow",
  "canvas": {
    "width": 560,
    "height": 360
  },
  "style": "deep-tech",
  "title": {
    "text": "Edge Packet Flow",
    "subtitle": "A continuously moving low-opacity track keeps every enabled edge visibly active; short edges use a solid role-colored dot while longer paths use a bright packet segment."
  },
  "motion": {
    "profile": "expressive",
    "sequence": "simultaneous",
    "ease": "spring",
    "stagger": 0.08,
    "duration_scale": 0.95,
    "intensity": 1.1,
    "edge": {
      "preset": "signal-arrow",
      "particle_count": 1,
      "trail_count": 0
    },
    "node": {
      "preset": "none"
    },
    "group": {
      "preset": "static"
    },
    "title": {
      "preset": "none"
    },
    "reduced_motion": "subtle"
  },
  "motion_policy": {
    "profile": "expressive",
    "motion_area": "small",
    "max_active_flow_edges": 4,
    "max_particle_edges": 4,
    "particle_count_per_edge": 1,
    "flow_trail_count": 0,
    "max_active_pulse_nodes": 4,
    "max_scanning_groups": 0
  },
  "nodes": [
    {
      "id": "source",
      "label": "Source",
      "caption": "packet enters",
      "position": [
        70,
        205
      ],
      "size": [
        160,
        84
      ],
      "role": "source",
      "effect": {
        "preset": "fade"
      }
    },
    {
      "id": "target",
      "label": "Target",
      "caption": "packet exits",
      "position": [
        330,
        205
      ],
      "size": [
        160,
        84
      ],
      "role": "memory",
      "effect": {
        "preset": "fade"
      }
    }
  ],
  "edges": [
    {
      "from": "source",
      "to": "target",
      "label": "data flow",
      "role": "source",
      "effect": {
        "preset": "signal-arrow"
      }
    }
  ]
}
