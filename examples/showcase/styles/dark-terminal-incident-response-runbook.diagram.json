      "role": "neutral"
    }
  ],
  "nodes": [
    {
      "id": "alert",
      "label": "Alert",
      "caption": "page on-call",
      "position": [
        110,
        145
      ],
      "size": [
        180,
        84
      ],
      "role": "risk",
      "icon": "shield"
    },
    {
      "id": "shell",
      "label": "Shell",
      "caption": "inspect",
      "position": [
        110,
        275
      ],
      "size": [
        180,
        84
      ],
      "role": "tool",
      "icon": "api"
    },
    {
      "id": "isolate",
      "label": "Isolate",
      "caption": "contain",
      "position": [
        110,
        405
      ],
      "size": [
        180,
        84
      ],
      "role": "process",
      "icon": "cloud"
    },
    {
      "id": "patch",
      "label": "Patch",
      "caption": "fix",
      "position": [
        510,
        275
      ],
      "size": [
        180,
        84
      ],
      "role": "agent",
      "icon": "tool"
    },
    {
      "id": "verify",
      "label": "Verify",
      "caption": "checks",
      "position": [
        810,
        275
      ],
      "size": [
        180,
        84
      ],
      "role": "source",
      "icon": "search"
