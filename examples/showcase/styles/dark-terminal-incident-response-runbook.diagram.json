      "label": "lock",
      "role": "tool",
      "route": "vh"
    },
    {
      "from": "isolate",
      "to": "patch",
      "label": "handoff",
      "role": "process",
      "route": "orthogonal"
    },
    {
      "from": "patch",
      "to": "verify",
      "label": "test",
      "role": "agent",
      "route": "straight",
      "effect": {
        "preset": "flow-arrow",
        "particle": "soft-arrow",
        "trail": false
      }
    },
    {
      "from": "verify",
      "to": "notes",
