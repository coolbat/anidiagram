{
  "version": "0.3",
  "canvas": {
    "width": 1280,
    "height": 720
  },
  "style": "dark-terminal",
  "title": {
    "text": "Incident Response Runbook",
    "subtitle": "operators isolate, patch, and verify production"
  },
  "motion": {
    "profile": "expressive",
    "sequence": "step-stagger",
    "ease": "spring",
