{
  "version": "0.3",
  "canvas": {
    "width": 1280,
    "height": 720
  },
  "style": "blueprint",
  "title": {
    "text": "MCP Server Architecture",
    "subtitle": "client requests route through tools, resources, auth, and transport"
  },
  "motion": {
    "profile": "expressive",
    "sequence": "step-stagger",
    "ease": "spring",
    "stagger": 0.12,
    "duration_scale": 1.0,
    "intensity": 1.1,
    "edge": {
      "preset": "dynamic-dash",
      "particle": "soft-dot",
      "trail": false
    },
    "node": {
      "preset": "pop",
      "accent": "glow"
    },
    "group": {
      "preset": "border-scan"
    },
    "title": {
      "preset": "highlight-sweep"
    },
    "reduced_motion": "subtle"
  },
  "groups": [
    {
      "id": "client-plane",
      "label": "Client Plane",
      "bounds": [
        60,
        225,
        450,
        195
      ],
      "role": "source"
    },
    {
      "id": "server-plane",
      "label": "Server Plane",
      "bounds": [
        490,
        140,
        655,
        365
      ],
      "role": "agent"
    }
  ],
  "nodes": [
    {
      "id": "client",
      "label": "Client",
      "caption": "LLM host",
      "position": [
        90,
        300
      ],
      "size": [
        180,
        84
      ],
      "role": "actor",
      "icon": "agent"
    },
    {
      "id": "transport",
      "label": "Transport",
      "caption": "stdio / http",
      "position": [
        300,
        300
      ],
      "size": [
        180,
        84
      ],
      "role": "tool",
      "icon": "api"
    },
    {
      "id": "server",
      "label": "MCP Server",
      "caption": "capability router",
      "position": [
        520,
        300
      ],
      "size": [
        190,
        88
      ],
      "role": "agent",
      "icon": "tool"
    },
    {
      "id": "tools",
      "label": "Tools",
      "caption": "actions",
      "position": [
        775,
        205
      ],
      "size": [
        180,
        84
      ],
      "role": "process",
      "icon": "tool"
    },
    {
      "id": "resources",
      "label": "Resources",
      "caption": "read context",
      "position": [
        775,
        395
      ],
      "size": [
        180,
        84
      ],
      "role": "memory",
      "icon": "folder"
    },
    {
      "id": "policy",
      "label": "Policy",
      "caption": "auth + limits",
      "position": [
        1000,
        300
      ],
      "size": [
        180,
        84
      ],
      "role": "risk",
      "icon": "shield"
    }
  ],
  "edges": [
    {
      "from": "client",
      "to": "transport",
      "label": "request",
      "role": "actor",
      "route": "straight"
    },
    {
      "from": "transport",
      "to": "server",
      "label": "message",
      "role": "tool",
      "route": "straight"
    },
    {
      "from": "server",
      "to": "tools",
      "label": "invoke",
      "role": "process",
      "route": "orthogonal",
      "effect": {
        "preset": "flow-arrow",
        "particle": "soft-arrow",
        "trail": false
      }
    },
    {
      "from": "server",
      "to": "resources",
      "label": "read",
      "role": "memory",
      "route": "orthogonal",
      "effect": {
        "preset": "dynamic-dash",
        "particle": "soft-dot",
        "trail": false
      }
    },
    {
      "from": "tools",
      "to": "policy",
      "label": "guard",
      "role": "risk",
      "route": "orthogonal"
    },
    {
      "from": "resources",
      "to": "policy",
      "label": "scope",
      "role": "risk",
      "route": "orthogonal"
    }
  ]
}
