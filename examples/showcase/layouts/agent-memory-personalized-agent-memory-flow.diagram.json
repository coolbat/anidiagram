  "edges": [
    {
      "from": "user",
      "to": "agent",
      "label": "intent",
      "role": "actor",
      "route": "straight"
    },
    {
      "from": "agent",
      "to": "search",
      "label": "context",
      "role": "source",
      "route": "orthogonal",
      "effect": {
        "preset": "signal-arrow",
        "particle": "soft-dot",
        "trail": false
      }
    },
    {
      "from": "agent",
      "to": "tool",
      "label": "action",
      "role": "tool",
      "route": "orthogonal",
      "effect": {
        "preset": "signal-arrow",
        "particle": "soft-dot",
        "trail": false
      },
      "animated": false
    },
    {
      "from": "search",
      "to": "memory",
      "label": "facts",
      "role": "memory",
      "route": "orthogonal",
      "effect": {
        "preset": "signal-dot",
        "particle": "soft-dot",
        "trail": false
      }
    },
    {
      "from": "tool",
      "to": "memory",
      "label": "result",
      "role": "memory",
      "route": "orthogonal",
      "effect": {
        "preset": "signal-dot",
        "particle": "soft-dot",
        "trail": false
      },
      "animated": false
    },
    {
      "from": "memory",
      "to": "output",
      "label": "ground",
      "role": "output",
      "route": "straight"
    }
  ],
  "motion_policy": {
    "profile": "focused",
    "motion_area": "small",
    "max_active_flow_edges": 4,
    "max_particle_edges": 4,
    "particle_count_per_edge": 1,
    "flow_trail_count": 0,
    "max_active_pulse_nodes": 3,
    "pulse_mode": "rotate",
    "max_scanning_groups": 0
  },
  "preset": "agent-memory"
}
