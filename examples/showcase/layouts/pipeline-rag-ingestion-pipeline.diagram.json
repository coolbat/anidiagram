{
  "version": "0.3",
  "canvas": {
    "width": 1280,
    "height": 720
  },
  "style": "blueprint",
  "title": {
    "text": "RAG Ingestion Pipeline",
    "subtitle": "documents become chunks, embeddings, retrieval, and grounded answers"
  },
  "motion": {
    "profile": "teaching",
    "sequence": "step-stagger",
    "ease": "spring",
    "stagger": 0.12,
    "duration_scale": 1.0,
    "intensity": 1.0,
    "edge": {
      "preset": "signal-arrow",
      "particle": "soft-dot",
      "trail": false
    },
    "node": {
      "preset": "icon-performance",
      "accent": "glow"
    },
    "group": {
      "preset": "soft-reveal"
    },
    "title": {
      "preset": "highlight-sweep"
    },
    "reduced_motion": "subtle"
  },
  "groups": [
    {
      "id": "rag",
      "label": "RAG Pipeline",
      "bounds": [
        45,
        250,
        1180,
        185
      ],
      "role": "process"
    }
  ],
  "nodes": [
    {
      "id": "docs",
      "label": "Docs",
      "caption": "source files",
      "position": [
        70,
        315
      ],
      "size": [
        180,
        84
      ],
      "role": "source",
      "icon": "folder"
    },
    {
      "id": "chunk",
      "label": "Chunk",
      "caption": "split text",
      "position": [
        265,
        315
      ],
      "size": [
        180,
        84
      ],
      "role": "process",
      "icon": "file"
    },
    {
      "id": "embed",
      "label": "Embed",
      "caption": "vectors",
      "position": [
        460,
        315
      ],
      "size": [
        180,
        84
      ],
      "role": "tool",
      "icon": "api"
    },
    {
      "id": "vector",
      "label": "Vector DB",
      "caption": "store",
      "position": [
        655,
        315
      ],
      "size": [
        180,
        84
      ],
      "role": "memory",
      "icon": "database"
    },
    {
      "id": "retrieve",
      "label": "Retrieve",
      "caption": "top-k",
      "position": [
        850,
        315
      ],
      "size": [
        180,
        84
      ],
      "role": "agent",
      "icon": "search"
    },
    {
      "id": "answer",
      "label": "Answer",
      "caption": "grounded",
      "position": [
        1045,
        315
      ],
      "size": [
        180,
        84
      ],
      "role": "output",
      "icon": "output"
    }
  ],
  "edges": [
    {
      "from": "docs",
      "to": "chunk",
      "label": "flow",
      "role": "process",
      "route": "straight"
    },
    {
      "from": "chunk",
      "to": "embed",
      "label": "flow",
      "role": "process",
      "route": "straight"
    },
    {
      "from": "embed",
      "to": "vector",
      "label": "flow",
      "role": "process",
      "route": "straight"
    },
    {
      "from": "vector",
      "to": "retrieve",
      "label": "flow",
      "role": "process",
      "route": "straight"
    },
    {
      "from": "retrieve",
      "to": "answer",
      "label": "flow",
      "role": "process",
      "route": "straight",
      "animated": false
    }
  ],
  "motion_policy": {
    "profile": "focused",
    "motion_area": "small",
    "max_active_flow_edges": 4,
    "max_particle_edges": 4,
    "particle_count_per_edge": 1,
    "flow_trail_count": 0,
    "max_active_pulse_nodes": 3,
    "pulse_mode": "rotate",
    "max_scanning_groups": 0
  },
  "preset": "pipeline"
}
