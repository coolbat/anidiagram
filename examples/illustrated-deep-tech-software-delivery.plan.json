        "importance": "primary",
        "repeat": "event-driven"
      },
      {
        "id": "verification-flow",
        "label": "Verification evidence flow",
        "description": "The execution path produces traceable quality evidence",
        "relation_ids": ["submit-intent", "delegate-execution", "execute-validation", "publish-evidence"],
        "importance": "supporting",
        "repeat": "event-driven"
      }
    ]
  },
  "presentation": {
    "icon_system": "illustrated",
    "style": "deep-tech",
    "layout": "layered",
    "motion": "showcase-v1"
  }
