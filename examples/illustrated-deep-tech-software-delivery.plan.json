        "label": "goal + constraints",
        "direction": "forward",
        "importance": "primary"
      },
      {
        "id": "delegate-plan",
        "from": "orchestrator",
        "to": "planner",
        "kind": "delegation",
        "label": "decompose",
        "direction": "forward",
        "importance": "primary"
      },
      {
        "id": "delegate-execution",
        "from": "orchestrator",
        "to": "executor",
        "kind": "delegation",
        "label": "route",
        "direction": "forward",
        "importance": "primary"
      },
      {
        "id": "plan-tool-actions",
        "from": "planner",
        "to": "code-tools",
        "kind": "tool-call",
        "label": "plan",
        "direction": "forward",
        "importance": "primary"
      },
      {
        "id": "execute-validation",
        "from": "executor",
        "to": "validation-tools",
        "kind": "tool-call",
        "label": "tests",
        "direction": "forward",
        "importance": "primary"
      },
      {
        "id": "package-release",
        "from": "code-tools",
        "to": "release-package",
        "kind": "delivery",
        "label": "build",
        "direction": "forward",
        "importance": "primary"
      },
      {
        "id": "publish-evidence",
