        "to": "verification-report",
        "kind": "observability",
        "label": "proof",
        "direction": "forward",
        "importance": "supporting"
      }
    ],
    "groups": [
      {
        "id": "specialist-agents",
        "label": "Specialist Agents",
        "description": "Planning and coordinated execution",
        "kind": "system",
        "members": ["planner", "executor"],
        "importance": "primary"
      },
      {
        "id": "execution-plane",
        "label": "Execution Plane",
        "description": "Implementation and verification tools",
        "kind": "system",
        "members": ["code-tools", "validation-tools"],
        "importance": "primary"
      },
      {
        "id": "delivery-plane",
        "label": "Delivery Surfaces",
        "description": "Release and evidence outputs",
        "kind": "system",
        "members": ["release-package", "verification-report"],
        "importance": "supporting"
      }
    ],
    "flows": [
      {
        "id": "build-flow",
        "label": "Build delivery flow",
        "description": "Intent becomes a packaged release artifact",
