{
  "version": "0.2",
  "semantic": {
    "title": "Autonomous Software Delivery Architecture",
    "subtitle": "Human intent → multi-agent planning → tool execution → verified outputs",
    "summary": "Show how one delivery request is decomposed by agents, executed through tools, and returned as two verifiable outputs.",
    "intent": {
      "diagram_kind": "architecture",
      "primary_question": "How does an autonomous software delivery system turn human intent into verified release outputs?",
      "audience": ["technical", "product"],
      "scope": "Control plane, execution tools, and delivery artifacts",
      "exclusions": "Persistence, deployment infrastructure, and internal model serving"
    },
    "entities": [
      {
        "id": "operator",
        "label": "Human Operator",
        "description": "Intent and acceptance criteria",
        "kind": "operator",
        "role": "actor",
        "importance": "primary"
      },
      {
        "id": "orchestrator",
        "label": "Agent Orchestrator",
        "description": "Routes goals and execution state",
        "kind": "agent",
        "role": "agent",
        "importance": "primary"
      },
      {
        "id": "planner",
        "label": "Planning Agent",
        "description": "Builds the task graph",
        "kind": "agent",
        "role": "agent",
        "importance": "primary"
      },
      {
        "id": "executor",
        "label": "Execution Agent",
        "description": "Coordinates work and checks",
        "kind": "agent",
        "role": "agent",
        "importance": "primary"
      },
      {
        "id": "code-tools",
        "label": "Code Toolchain",
        "description": "Edit, build, and package",
        "kind": "tool",
        "role": "tool",
        "importance": "primary"
      },
      {
        "id": "validation-tools",
        "label": "Validation Suite",
        "description": "Tests, policies, and runtime checks",
        "kind": "tool",
        "role": "tool",
        "importance": "primary"
      },
      {
        "id": "release-package",
        "label": "Release Package",
        "description": "Versioned deployment artifact",
        "kind": "output",
        "role": "output",
        "importance": "primary",
        "state": {
          "phase": "ready",
          "result": "success",
          "availability": "online"
        }
      },
      {
        "id": "verification-report",
        "label": "Verification Report",
        "description": "Evidence and acceptance result",
        "kind": "output",
        "role": "output",
        "importance": "supporting",
        "state": {
          "phase": "verified",
          "result": "success",
          "availability": "online"
        }
      }
