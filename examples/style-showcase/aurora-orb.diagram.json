{
  "version": "0.3",
  "canvas": {
    "width": 1280,
    "height": 720
  },
  "style": "aurora-orb",
  "title": {
    "text": "Creative Agent Studio",
    "subtitle": "briefs become variants, reviews, and publishable assets"
  },
  "motion": {
    "profile": "expressive",
    "sequence": "step-stagger",
    "ease": "spring",
    "stagger": 0.12,
    "duration_scale": 1.0,
    "intensity": 1.2,
    "edge": {
      "preset": "ghost-flow",
      "particle": "soft-dot",
      "trail": true
    },
    "node": {
      "preset": "icon-pulse",
      "accent": "ripple"
    },
    "group": {
      "preset": "border-scan"
    },
    "title": {
      "preset": "highlight-sweep"
    },
    "reduced_motion": "subtle"
  },
  "groups": [
    {
      "id": "studio",
      "label": "Studio Canvas",
      "bounds": [
        55,
        145,
        1090,
        420
      ],
      "role": "agent"
    }
  ],
  "nodes": [
    {
      "id": "brief",
      "label": "Brief",
      "caption": "intent",
      "position": [
        90,
        315
      ],
      "size": [
        180,
        84
      ],
      "role": "actor",
      "icon": "file"
    },
    {
      "id": "mood",
      "label": "Mood",
      "caption": "palette",
      "position": [
        305,
        210
      ],
      "size": [
        180,
        84
      ],
      "role": "source",
      "icon": "folder"
    },
    {
      "id": "agent",
      "label": "Studio Agent",
      "caption": "compose",
      "position": [
        520,
        315
      ],
      "size": [
        205,
        92
      ],
      "role": "agent",
      "icon": "agent"
    },
    {
      "id": "variants",
      "label": "Variants",
      "caption": "options",
      "position": [
        765,
        210
      ],
      "size": [
        180,
        84
      ],
      "role": "tool",
      "icon": "tool"
    },
    {
      "id": "review",
      "label": "Review",
      "caption": "select",
      "position": [
        765,
        420
      ],
      "size": [
        180,
        84
      ],
      "role": "risk",
      "icon": "shield"
    },
    {
      "id": "publish",
      "label": "Publish",
      "caption": "export",
      "position": [
        1000,
        315
      ],
      "size": [
        180,
        84
      ],
      "role": "output",
      "icon": "output"
    }
  ],
  "edges": [
    {
      "from": "brief",
      "to": "agent",
      "label": "intent",
      "role": "actor",
      "route": "straight"
    },
    {
      "from": "mood",
      "to": "agent",
      "label": "style",
      "role": "source",
      "route": "orthogonal",
      "effect": {
        "preset": "ghost-flow",
        "particle": "soft-dot",
        "trail": true
      }
    },
    {
      "from": "agent",
      "to": "variants",
      "label": "create",
      "role": "agent",
      "route": "orthogonal",
      "effect": {
        "preset": "flow-arrow",
        "particle": "soft-arrow",
        "trail": false
      }
    },
    {
      "from": "variants",
      "to": "review",
      "label": "choose",
      "role": "tool",
      "route": "vh"
    },
    {
      "from": "review",
      "to": "publish",
      "label": "approve",
      "role": "output",
      "route": "orthogonal",
      "effect": {
        "preset": "flow-dot",
        "particle": "soft-dot",
        "trail": false
      }
    }
  ]
}
