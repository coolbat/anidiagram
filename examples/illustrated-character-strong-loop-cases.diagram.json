  "motion_policy": {
    "profile": "focused",
    "motion_area": "small",
    "max_active_flow_edges": 0,
    "max_particle_edges": 0,
    "max_active_pulse_nodes": 4,
    "max_scanning_groups": 0
  },
  "nodes": [
