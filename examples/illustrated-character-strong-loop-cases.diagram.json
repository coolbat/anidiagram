{
  "version": "0.3",
  "preset": "illustrated-character-strong-loop-cases",
  "canvas": {"width": 1280, "height": 720},
  "style": "illustrated-character",
  "title": {
    "text": "Strong Character Loops",
    "subtitle": "Four high-energy semantic performances: think, operate, execute, and deliver"
  },
  "motion": {
    "profile": "expressive",
    "sequence": "loop",
    "stagger": 0.12,
    "intensity": 1.65,
    "node": {"preset": "icon-performance"},
    "edge": {"preset": "static"},
    "group": {"preset": "static"},
    "title": {"preset": "highlight-sweep"},
    "reduced_motion": "subtle"
