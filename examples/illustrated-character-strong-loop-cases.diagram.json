      "size": [520, 190],
      "role": "agent",
      "icon": "agent"
    },
    {
      "id": "operate",
      "label": "Operate",
      "caption": "focus • type • resolve",
      "position": [680, 180],
      "size": [520, 190],
      "role": "source",
      "icon": "operator"
    },
    {
      "id": "execute",
      "label": "Execute",
      "caption": "open • swing • confirm",
      "position": [80, 440],
      "size": [520, 190],
      "role": "tool",
      "icon": "tool"
    },
    {
      "id": "deliver",
      "label": "Deliver",
      "caption": "lift • reveal • celebrate",
      "position": [680, 440],
      "size": [520, 190],
      "role": "output",
      "icon": "output"
    }
  ]
}
