        "direction": "forward",
        "importance": "primary"
      },
      {
        "id": "query-vectors",
        "from": "retriever",
        "to": "vector-database",
        "kind": "retrieval",
        "label": "semantic query",
        "direction": "forward",
        "importance": "primary"
      },
      {
        "id": "return-evidence",
        "from": "vector-database",
        "to": "rag-agent",
        "kind": "feedback",
        "label": "ranked evidence",
        "direction": "forward",
        "importance": "primary"
      },
      {
        "id": "maintain-context",
        "from": "rag-agent",
        "to": "conversation-memory",
        "kind": "context",
        "label": "read / write context",
        "direction": "bidirectional",
        "importance": "supporting"
      },
      {
        "id": "deliver-answer",
        "from": "rag-agent",
        "to": "grounded-answer",
        "kind": "delivery",
        "label": "cited response",
        "direction": "forward",
        "importance": "primary"
      }
    ],
    "groups": [
      {
        "id": "knowledge-ingestion-plane",
        "label": "Knowledge Ingestion Plane",
        "description": "Curated content becomes retrieval-ready knowledge",
        "kind": "system",
        "members": [
          "knowledge-owner",
          "source-files",
          "document-library",
          "cloud-intake",
          "ingestion-toolchain",
          "vector-database"
        ],
        "importance": "primary"
      },
      {
        "id": "governed-rag-runtime",
        "label": "Governed RAG Runtime",
        "description": "Authorized requests retrieve evidence and produce grounded responses",
        "kind": "system",
        "members": [
          "rag-api",
          "policy-guard",
          "rag-agent",
          "retriever",
          "conversation-memory",
          "grounded-answer"
        ],
        "importance": "primary"
      }
    ],
    "flows": [
