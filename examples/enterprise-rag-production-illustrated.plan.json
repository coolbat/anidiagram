{
  "version": "0.2",
  "semantic": {
    "title": "Enterprise RAG Production Architecture",
    "subtitle": "Curated ingestion, policy-scoped retrieval, memory, and grounded response delivery",
    "summary": "Show how enterprise documents are prepared for retrieval and how a governed RAG agent turns an API request into a grounded answer.",
    "intent": {
      "diagram_kind": "architecture",
      "primary_question": "How does a production RAG system ingest approved enterprise knowledge and return policy-scoped grounded answers?",
      "audience": [
        "technical",
        "product"
      ],
      "scope": "Document ingestion, policy enforcement, vector retrieval, conversation memory, agent orchestration, and response delivery",
      "exclusions": [
        "Model training",
        "cluster infrastructure",
        "observability internals",
        "vendor-specific services"
      ]
    },
    "entities": [
      {
        "id": "knowledge-owner",
        "label": "Knowledge Owner",
        "description": "Curates approved enterprise content",
        "kind": "operator",
        "role": "actor",
        "importance": "primary"
      },
      {
        "id": "source-files",
        "label": "Source Files",
        "description": "Policies, manuals, and records",
        "kind": "file",
        "role": "source",
        "importance": "primary"
      },
      {
        "id": "document-library",
        "label": "Document Library",
        "description": "Organized and versioned corpus",
        "kind": "folder",
        "role": "source",
        "importance": "primary"
      },
      {
        "id": "cloud-intake",
        "label": "Cloud Intake",
        "description": "Synchronizes approved content",
        "kind": "cloud",
        "role": "process",
        "importance": "primary"
      },
      {
        "id": "ingestion-toolchain",
        "label": "Ingestion Toolchain",
        "description": "Parses, chunks, and embeds",
        "kind": "tool",
        "role": "tool",
        "importance": "primary"
      },
      {
        "id": "vector-database",
        "label": "Vector Database",
        "description": "Stores searchable knowledge vectors",
        "kind": "database",
        "role": "memory",
        "importance": "primary"
      },
      {
        "id": "rag-api",
        "label": "RAG API",
        "description": "Receives application queries",
        "kind": "api",
        "role": "source",
        "importance": "primary"
      },
      {
        "id": "policy-guard",
        "label": "Policy Guard",
        "description": "Authenticates and scopes access",
        "kind": "shield",
        "role": "risk",
        "importance": "primary"
      },
      {
        "id": "rag-agent",
        "label": "RAG Agent",
