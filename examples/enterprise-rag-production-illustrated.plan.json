        "label": "Knowledge ingestion",
        "description": "Approved enterprise documents become searchable vectors",
        "relation_ids": [
          "upload-content",
          "organize-corpus",
          "sync-library",
          "prepare-knowledge",
          "index-vectors"
        ],
        "importance": "primary",
        "repeat": "event-driven"
      },
      {
        "id": "governed-retrieval-flow",
        "label": "Governed retrieval",
        "description": "An authorized query is planned, retrieved, and matched to enterprise evidence",
        "relation_ids": [
          "receive-query",
          "authorize-query",
          "plan-retrieval",
          "query-vectors"
        ],
        "importance": "primary",
        "repeat": "event-driven"
      },
      {
        "id": "grounded-response-flow",
        "label": "Grounded response",
        "description": "Ranked evidence returns to the agent and becomes a cited answer",
        "relation_ids": [
          "return-evidence",
          "deliver-answer"
        ],
        "importance": "primary",
        "repeat": "event-driven"
      },
      {
        "id": "conversation-context-loop",
        "label": "Conversation context",
        "description": "The agent reads and updates authorized session context",
        "relation_ids": [
          "maintain-context"
        ],
        "importance": "supporting",
        "repeat": "loop"
      }
    ]
