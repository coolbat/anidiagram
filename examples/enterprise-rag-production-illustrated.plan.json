        "role": "tool",
        "importance": "primary"
      },
      {
        "id": "conversation-memory",
        "label": "Conversation Memory",
        "description": "Maintains authorized session context",
        "kind": "memory",
        "role": "memory",
        "importance": "supporting"
      },
      {
        "id": "grounded-answer",
        "label": "Grounded Answer",
        "description": "Returns a cited, policy-safe response",
        "kind": "output",
        "role": "output",
        "importance": "primary",
        "state": {
          "phase": "ready",
          "result": "success",
          "availability": "online"
        }
      }
